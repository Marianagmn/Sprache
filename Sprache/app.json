{
  "expo": {
    "name": "Sprache",
    "slug": "Sprache",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "backgroundColor": "#F4F4F5",
    "primaryColor": "#FFCE00",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/sprache-logo.png",
          "imageWidth": 208,
          "resizeMode": "contain",
          "backgroundColor": "#F4F4F5"
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFCE00",
        "foregroundImage": "./assets/sprache-logo.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "themeColor": "#FFCE00",
      "backgroundColor": "#F4F4F5"
    }
  }
}
